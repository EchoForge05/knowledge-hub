{
  "name": "knowledge-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.22.1 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vitepress dev knowledge --host 127.0.0.1",
    "build": "vitepress build knowledge",
    "preview": "vitepress preview knowledge --host 127.0.0.1",
    "check": "node scripts/check-docs.mjs",
    "check:site": "node scripts/check-site.mjs",
    "ai:draft": "node --env-file-if-exists=.env.local scripts/ai-draft.mjs",
    "test:ai": "node --test scripts/ai-draft.test.mjs",
    "issue:intake": "node scripts/issue-intake.mjs",
    "test:issue": "node --test scripts/issue-intake.test.mjs"
  },
  "devDependencies": { "vitepress": "1.6.4" }
}
